{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shell-online-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.shell.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "__HYPERDRIVE_ID__",
      "localConnectionString": "postgres://postgres:dev@localhost:5433/shell_online"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "__FIREBASE_PROJECT_ID__",
    "WEB_ORIGIN": "https://app.shell.online",
    "RELAY_URL": "https://shell.online",
    "MAIL_PROVIDER": "sendgrid",
    "MAIL_FROM": "__MAIL_FROM__"
  }
}
