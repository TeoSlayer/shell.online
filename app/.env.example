# Choose one sign-in configuration. OIDC takes precedence only when both
# values are set. Leaving them blank preserves the Firebase sign-in screens.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# What the server checks tokens against. Both default to the VITE_ values
# above, so they only need setting when they differ.
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=
# FIREBASE_PROJECT_ID defaults to VITE_FIREBASE_PROJECT_ID.

# App and relay
VITE_RELAY_URL=
RELAY_URL=https://shell.online
WEB_ORIGIN=http://localhost:8080

# PostgreSQL for docker compose
POSTGRES_PASSWORD=

# Set only behind a proxy that replaces X-Forwarded-For
TRUST_PROXY=0

# Optional, 32+ characters. The same value goes on the relay Worker as
# APP_STATS_TOKEN so its statistics dashboard can read account counts.
# STATS_TOKEN=

# Optional invitation email. Defaults to SendGrid.
MAIL_PROVIDER=sendgrid
MAIL_API_KEY=
MAIL_FROM=shell.online <no-reply@shell.online>
# MAIL_API_URL=https://api.example.com/emails

# Where feedback sent from the app is forwarded. Empty keeps it in the database only.
FEEDBACK_TO=
