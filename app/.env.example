# The OpenID Connect provider, compiled into the client. The issuer is the
# realm or tenant URL that serves /.well-known/openid-configuration; the client
# id is the public, PKCE client registered there for this app.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=

# What the server checks tokens against. Both default to the VITE_ values
# above, so they only need setting when they differ.
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=

# App and relay
VITE_RELAY_URL=
RELAY_URL=https://shell.online
WEB_ORIGIN=http://localhost:8080

# PostgreSQL for docker compose
POSTGRES_PASSWORD=

# Set only behind a proxy that replaces X-Forwarded-For
TRUST_PROXY=0

# Optional invitation email. Defaults to SendGrid.
MAIL_PROVIDER=sendgrid
MAIL_API_KEY=
MAIL_FROM=shell.online <no-reply@shell.online>
# MAIL_API_URL=https://api.example.com/emails

# Where feedback sent from the app is forwarded. Empty keeps it in the database only.
FEEDBACK_TO=
