# Firebase web app config. Values come from the Firebase console, or from:
#   curl -H "Authorization: Bearer $(gcloud auth print-access-token)" \
#        -H "x-goog-user-project: <project>" \
#        "https://firebase.googleapis.com/v1beta1/projects/<project>/webApps/<appId>/config"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

VITE_RELAY_URL=

# ---- Deployment (docker compose) --------------------------------------
# The relay to forward terminal websockets to. Your own shell.online worker,
# or https://shell.online. Required whenever this process serves the client.
RELAY_URL=https://shell.online

# Where browsers reach this deployment, used for CORS and for the links the
# CLI is sent to. The public URL, not the container's address.
WEB_ORIGIN=http://localhost:8080

# Postgres. The service refuses to start under NODE_ENV=production without it.
POSTGRES_PASSWORD=
# DATABASE_URL is composed by docker-compose; set it directly when deploying
# somewhere else: postgres://user:password@host:5432/shell_online

# Set to 1 only when a proxy in front rewrites X-Forwarded-For.
TRUST_PROXY=0

# ---- Outgoing mail --------------------------------------------------
# SendGrid by default: set MAIL_API_KEY and MAIL_FROM and nothing else.
#
# The From address must be one SendGrid will send as: either a verified
# Sender Identity, or any address at an authenticated domain. This account
# Authenticate shell.online with the selected provider before sending. An
# unverified address is normally refused with 403.
#
# MAIL_PROVIDER=json instead posts a flat {from,to,subject,html,text} body
# to MAIL_API_URL, which is what Resend and Postmark accept.
#
# With the key or the sender missing, an invitation is logged rather than
# sent and its link still works. Put the real key in .env.local, which is
# gitignored; never in this file.
MAIL_PROVIDER=sendgrid
MAIL_API_KEY=
MAIL_FROM=shell.online <no-reply@shell.online>
# MAIL_API_URL=https://api.resend.com/emails
